# Copier en .env.local et choisir un mot de passe (lettres et chiffres)
ESERVICES_DB_PASSWORD=changez-moi
# Clé du cachet électronique visible des livrables (64 caractères hexadécimaux)
ESERVICES_SEAL_SECRET=changez-moi
# Stockage objet MinIO (facultatif) : sans MINIO_URL, les fichiers restent en base
# MINIO_URL=http://localhost:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=nexora-eservices
