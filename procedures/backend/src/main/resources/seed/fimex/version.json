  "businessRules": [
    { "code": "UC-01 RG1", "text": "Les autorisations spéciales ne font pas l'objet d'un renouvellement.", "source": "SFD FIMEX v1.4 UC-01 / UC-02", "drlRule": "RG1 - Pas de renouvellement des autorisations spéciales" },
    { "code": "UC-01 RG2", "text": "Les autorisations spéciales s'appliquent à l'importation pour des catégories de marchandises précises (liste à fournir par l'administration).", "source": "SFD FIMEX v1.4 UC-01", "drlRule": "Import - pays d'origine des marchandises" },
    { "code": "UC-01 RG3", "text": "Une demande d'inscription ne passe au traitement qu'après le paiement des frais.", "source": "SFD FIMEX v1.4 UC-01", "drlRule": "Frais MINCOMMERCE" },
    { "code": "UC-01 RG4", "text": "Un importateur ou exportateur ne peut initier la demande pour un tiers.", "source": "SFD FIMEX v1.4 UC-01", "drlRule": "RG4 - Un opérateur ne dépose pas pour un tiers" },
    { "code": "UC-01 RG5", "text": "Un CDA peut initier la demande d'inscription pour lui et des tiers.", "source": "SFD FIMEX v1.4 UC-01", "drlRule": "RG4 - Un opérateur ne dépose pas pour un tiers" },
    { "code": "UC-01 RG6", "text": "Nomenclature des numéros de dossiers : Pays_Année_Code procédure_Séquence (CM2026IFI000001, CM2026IFE000002, CM2026ASC000005).", "source": "SFD FIMEX v1.4 UC-01 (v1.4)", "drlRule": null },
    { "code": "UC-01 RM1", "text": "Ajout des marchandises dans l'onglet produits sur la base minimale des 6 premiers caractères du SH.", "source": "SFD FIMEX v1.4 UC-01", "drlRule": "RM1 - Au moins un produit, code SH sur 6 chiffres minimum" },
    { "code": "UC-02 RG05", "text": "L'année de renouvellement ne peut être que l'année n+1 de l'année en cours.", "source": "SFD FIMEX v1.4 UC-02", "drlRule": "RG05 - Année de renouvellement n+1" },
    { "code": "UC-02 RG06", "text": "Si le renouvellement est initié alors que le FIMEX est encore valide, il prend effet le 1er janvier de l'année n+1.", "source": "SFD FIMEX v1.4 UC-02", "drlRule": null },
    { "code": "UC-02 RG07", "text": "Impossible d'initier un renouvellement si un autre est en cours de traitement ou déjà validé.", "source": "SFD FIMEX v1.4 UC-02", "drlRule": "RG07 - Un seul renouvellement en cours ou validé par année" },
    { "code": "UC-03 RG1", "text": "Une demande d'amendement ne fait pas l'objet d'un paiement ; elle est directement transmise pour traitement.", "source": "SFD FIMEX v1.4 UC-03 (v1.2)", "drlRule": "Frais MINCOMMERCE" },
    { "code": "UC-04 RG2", "text": "L'agent n'a de vue que sur les dossiers qui lui sont cotés.", "source": "SFD FIMEX v1.4 UC-04", "drlRule": null },
    { "code": "UC-04 RG3", "text": "Le rejet clôt le workflow du dossier, sans remboursement des frais payés.", "source": "SFD FIMEX v1.4 UC-04", "drlRule": null },
    { "code": "UC-04.1 RM03", "text": "Les dossiers sont cotés de manière aléatoire et équitable entre les agents de traitement de la même unité (lieu de traitement).", "source": "SFD FIMEX v1.4 UC-04.1 (v1.3)", "drlRule": null },
    { "code": "UC-05 RG1", "text": "L'attestation signée porte un code QR, le nom du signataire, son cachet, la date de signature et la date d'expiration.", "source": "SFD FIMEX v1.4 UC-05", "drlRule": null },
    { "code": "UC-05 RG2", "text": "À la validation, les données manquantes de l'opérateur dans le référentiel sont mises à jour avec celles du FIMEX.", "source": "SFD FIMEX v1.4 UC-05", "drlRule": null }
  ],
